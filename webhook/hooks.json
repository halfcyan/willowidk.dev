[
  {
    "id": "rebuild-site",
    "execute-command": "/opt/rebuild.sh",
    "command-working-directory": "/opt/webhook",
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hash-sha256",
            "secret": "{{.Env.WEBHOOK_SECRET}}",
            "parameter": {
              "source": "header",
              "name": "X-Hub-Signature-256"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "refs/heads/main",
            "parameter": {
              "source": "payload",
              "name": "ref"
            }
          }
        }
      ]
    }
  }
]

